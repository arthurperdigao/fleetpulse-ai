{
  "name": "fleetpulse-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Monitoramento de preços de locação de veículos com detecção de anomalias e assistente auditado contra alucinações",
  "workspaces": [
    "apps/*",
    "pacotes/*"
  ],
  "scripts": {
    "coletor:spike": "npm run spike:localiza --workspace=@fleetpulse/coletor",
    "testar": "npm run testar --workspaces --if-present",
    "compilar": "npm run compilar --workspaces --if-present",
    "semear": "npm run semear --workspace=@fleetpulse/coletor",
    "evals": "vitest run evals/runner.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
